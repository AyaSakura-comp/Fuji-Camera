# Tailscale auth key for the sidecar. Create one at:
#   https://login.tailscale.com/admin/settings/keys
# Only needed for the FIRST node registration; once ts-state is authed, leave unset.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# Shared passcode gate (recommended when exposing via Funnel). Set = require it;
# leave unset/empty for no gate (fine for tailnet-only use).
FUJI_PASSCODE=
