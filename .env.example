# Tailscale auth key for the sidecar. Create one at:
#   https://login.tailscale.com/admin/settings/keys
# Only needed for the FIRST node registration; once ts-state is authed, leave unset.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# Passcode gate (recommended when exposing via Funnel). EACH passcode is its own
# gallery (photos scoped to the passcode used to log in); the "processing" count
# stays global (shared GPU). Comma-separated for multiple. Empty = no gate.
FUJI_PASSCODES=8345
# legacy single-passcode var (still supported; merged with FUJI_PASSCODES)
FUJI_PASSCODE=
